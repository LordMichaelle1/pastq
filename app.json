{
  "expo": {
    "name": "PastQ",
    "slug": "pastq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pastq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abiodun.pastq"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12203A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abiodun.pastq"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12203A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "PastQ needs your photos so you can pick a past paper to scan."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PastQ uses the camera to photograph past papers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
